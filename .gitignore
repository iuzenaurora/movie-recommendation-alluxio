# Local configuration and credentials
.env
.env.*
!.env.example
!.env.*.example
auth.json
.pypirc
*.pem
*.key
/runtime/
/twohost/private-helper/

# Datasets and heavy model binary packages stay on local machine (DO NOT upload to GitHub)
/data/raw/
/data/processed/
/data/**/*.csv
/ml-25m/
/ml-32m/
/models/*
!/models/README.md
!/models/.gitkeep
*.parquet
*.npz
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z

# Ignore general CSV datasets, but ALLOW experimental result CSVs
*.csv
!/experiments/**/*.csv
!/docs/reports/**/*.csv

# Allow experimental results to be uploaded to GitHub
!/experiments/
!/experiments/**
!/docs/reports/**

# Python dependencies and generated files
__pycache__/
*.py[cod]
.venv/
venv/
env/
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# Laravel and frontend dependencies/cache
/web/vendor/
/web/node_modules/
/web/bootstrap/cache/*.php
/web/storage/logs/*
/web/storage/framework/cache/*
/web/storage/framework/sessions/*
/web/storage/framework/views/*
/web/storage/app/*
!/web/storage/app/.gitignore
!/web/storage/app/private/
!/web/storage/app/public/
/web/storage/app/private/*
!/web/storage/app/private/.gitignore
/web/storage/app/public/*
!/web/storage/app/public/.gitignore
/web/public/build/
/web/public/hot
/web/public/storage
/web/.phpunit.result.cache
/web/.phpunit.cache/
*.log
!/experiments/**/*.log

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.tmp
